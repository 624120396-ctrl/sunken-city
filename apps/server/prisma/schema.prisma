generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  displayId         Int      @unique
  email             String   @unique
  nickname          String
  password          String
  avatarUrl         String?
  exp               Int      @default(0)
  displayedTitleKey String?  // 当前展示的印记key
  isAdmin           Boolean  @default(false)

  // 货币系统
  coins             Int      @default(0)   // 锈蚀硬币
  stardust          Int      @default(0)   // 虚银

  // 装备
  equippedFrame     String?  // 当前装备的头像框 key

  // 展示角色（社交资料卡使用，与房间内绑定角色解耦）
  displayedCharacterId String?
  displayedCharacter   Character? @relation("UserDisplayedCharacter", fields: [displayedCharacterId], references: [id])

  // 每日签到
  lastCheckinAt     DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  characters      Character[]
  roomMembers     RoomMember[]
  diceRolls       DiceRoll[]
  unlockedTitles  UserTitle[]
  uploads         Upload[]
  inventory       UserInventory[]
  forumPosts      ForumPost[]
  forumReplies    ForumReply[]
  forumLikes      ForumPostLike[]
  lastReplyPosts  ForumPost[] @relation("LastReplyAuthor")
  notifications   Notification[]
  sentMessages    UserMessage[] @relation("SentUserMessages")
  receivedMessages UserMessage[] @relation("ReceivedUserMessages")
  boardModerators ForumBoardModerator[]

  // 好友系统
  sentFriendRequests     FriendRequest[]    @relation("SentRequests")
  receivedFriendRequests FriendRequest[]    @relation("ReceivedRequests")
  friendshipsA           Friendship[]       @relation("FriendshipsA")
  friendshipsB           Friendship[]       @relation("FriendshipsB")
  directMessagesSent     DirectMessage[]    @relation("SentDirectMessages")
  directMessagesReceived DirectMessage[]    @relation("ReceivedDirectMessages")

  // 剧本跑团系统
  authoredScenarios      Scenario[]
  achievements           UserAchievement[]
  dreamDailies           UserDreamDaily[]
  dreamDraws             UserDreamDraw[]
  fishingDailies         UserFishingDaily[]
  fishingLogs            UserFishingLog[]

  @@index([exp])
}

model Character {
  id          String   @id @default(uuid())
  displayId   Int      @unique
  userId      String
  name        String
  portraitUrl String?  // 半身像图片路径

  // COC7e 职业系统（职业名称与绑定）
  occupation  String   // 职业显示名称
  occupationKey String? // 绑定职业模板的key

  age         Int      @default(25)
  gender      String?
  avatarUrl   String?

  // 快捷技能栏
  quickSkills String   @default("[\"侦查\",\"聆听\",\"图书馆使用\",\"心理学\",\"话术\"]")

  // 8项基本属性（COC7e 规则值范围 15-90 左右）
  str         Int      @default(50)
  con         Int      @default(50)
  siz         Int      @default(50)
  dex         Int      @default(50)
  app         Int      @default(50)
  int         Int      @default(50)
  pow         Int      @default(50)
  edu         Int      @default(50)
  luck        Int      @default(50)

  // COC7e 新增：信用评级与资产
  creditRating Int     @default(0) // 信用评级 0-99
  cash         Int     @default(0) // 现金（美元）
  assetsValue  Int     @default(0) // 其他资产（美元）

  // 背景系统（结构化存储）
  background  String?  // 旧版兼容性保留
  backgroundEntries String @default("[]") // 6种背景条目 JSON
  keyConnection String? // 关键背景连接类型

  // 派生属性
  hp          Int      @default(10)
  mp          Int      @default(10)
  san         Int      @default(50)
  maxHp       Int      @default(10)
  maxMp       Int      @default(10)
  maxSan      Int      @default(50)
  mov         Int      @default(8)
  build       Int      @default(0)
  db          String?  // 伤害加值，如 "+1d4", "-1", "+2d6"

  // 技能与战斗
  skills      String   @default("{}") // 标准COC7技能JSON
  weapons     String   @default("[]")
  armor       String?

  // 技能点分配记录（用于校验和展示）
  skillPointsJson String @default("{}") // { occupationPoints: number, interestPoints: number, usedOccupation: number, usedInterest: number }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  displayedByUsers User[] @relation("UserDisplayedCharacter")
  roomMembers RoomMember[]
  privateMessagesSent   PrivateMessage[] @relation("SentMessages")
  privateMessagesReceived PrivateMessage[] @relation("ReceivedMessages")
  relics                  CharacterRelic[]
}

// COC7e 职业模板表
model Occupation {
  id                String @id @default(uuid())
  key               String @unique
  name              String
  nameEn            String?
  description       String?
  category          String @default("general") // general | academic | criminal | military | artistic

  // 技能点公式，如 "EDU*4", "EDU*2+APP*2", "EDU*2+DEX*2", "EDU*2+STR*2", "EDU*2+POW*2"
  skillPointFormula String @default("EDU*4")

  // 信用评级范围
  creditRatingMin   Int    @default(0)
  creditRatingMax   Int    @default(99)

  // 本职技能列表（JSON 字符串数组）
  coreSkills        String @default("[]")

  // 可选技能选择配置：例如 "自选一技能", "选四:估价,易容,格斗,射击,锁匠,机械维修,妙手"
  // 前端按此渲染选择器
  electiveSkills    String @default("[]")

  isActive          Boolean @default(true)
  sortOrder         Int    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Room {
  id          String   @id @default(uuid())
  roomId      String   @unique
  name        String
  description String?
  creatorId   String
  status      String   @default("ACTIVE")
  
  // 新增：氛围主题
  atmosphere  String   @default("normal") // normal, dark, horror, mystery, warm
  
  // 新增：当前场景描述
  sceneDesc   String?

  // ===== V2.1 新增 =====
  currentPhaseId   String?
  currentSceneId   String?
  activeCombatId   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     RoomMember[]
  diceRolls   DiceRoll[]
  privateMessages PrivateMessage[]
  countdowns  Countdown[]
  messages    RoomMessage[]
  clues       RoomClue[]
  npcs        RoomNpc[]
  scenarioSession ScenarioSession?

  // V2.1 关系
  phases           RoomPhase[]
  scenes           RoomScene[]
  combatSessions   CombatSession[]
  gmNotes          GmNote[]
  presets          ScenePreset[]
  eventLogs        RoomEventLog[]
  roomLogs         RoomLog[]
  subRooms         SubRoom[]
}

model RoomMember {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  characterId String?
  role        String   @default("PLAYER")
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  
  // 新增：角色状态标记（JSON数组：injured, poisoned, insane, unconscious, dying）
  statusTags  String   @default("[]")

  // ===== V2.1 新增 =====
  currentRound     Int      @default(0)
  displayedCharacterId String?

  room        Room      @relation(fields: [roomId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  character   Character? @relation(fields: [characterId], references: [id])

  @@unique([roomId, userId])
}

// 新增：房间公共聊天记录
model RoomMessage {
  id          String   @id @default(uuid())
  roomId      String
  userId      String?
  nickname    String   @default("未知")
  content     String
  characterId String?
  isSecret    Boolean  @default(false)
  type        String   @default("text") // text | dice | system
  meta        String   @default("{}")
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([createdAt])
}

model DiceRoll {
  id           String   @id @default(uuid())
  roomId       String?
  userId       String?
  rollType     String
  targetName   String?
  targetValue  Int?
  rollResult   Int
  rolls        String
  successLevel String?
  createdAt    DateTime @default(now())

  // ===== V2.1 新增 =====
  isBlind          Boolean  @default(false)
  visibleToUserIds String   @default("[]")

  room Room? @relation(fields: [roomId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model CombatLog {
  id        String   @id @default(uuid())
  roomId    String
  userId    String?
  round     Int      @default(1)
  actor     String
  action    String
  target    String?
  result    String
  timestamp DateTime @default(now())

  @@index([roomId])
}

model SessionReport {
  id            String   @id @default(uuid())
  roomId        String
  title         String
  summary       String?
  startTime     DateTime @default(now())
  endTime       DateTime?
  duration      Int?     // 分钟
  participantCount Int  @default(0)
  combatRounds  Int      @default(0)
  diceRollCount Int      @default(0)
  keyEvents     String   @default("[]")  // JSON array
  characterGrowth String @default("[]")  // JSON array
  exportedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([roomId])
}

// 新增：私聊消息表
model PrivateMessage {
  id          String   @id @default(uuid())
  roomId      String
  senderId    String
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id])
  sender      Character @relation("SentMessages", fields: [senderId], references: [id])
  receiver    Character @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([roomId, receiverId])
  @@index([createdAt])
}

// ===== V2.1 房间系统升级模型 =====

model RoomPhase {
  id          String   @id @default(uuid())
  roomId      String
  title       String
  description String?
  sortOrder   Int      @default(0)
  status      String   @default("active") // active | completed | skipped
  startedAt   DateTime @default(now())
  completedAt DateTime?

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scenes      RoomScene[]

  @@index([roomId])
}

model RoomScene {
  id          String   @id @default(uuid())
  phaseId     String
  roomId      String
  title       String
  description String?
  atmosphere  String   @default("normal") // normal | dark | horror | mystery | warm
  imageUrl    String?
  musicUrl    String?
  sortOrder   Int      @default(0)
  status      String   @default("draft") // draft | active | completed

  phase       RoomPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  npcs        RoomNpc[]

  @@index([phaseId])
  @@index([roomId])
}

model CombatSession {
  id          String   @id @default(uuid())
  roomId      String
  roundCount  Int      @default(0)
  status      String   @default("active") // active | paused | ended
  initiative  String   @default("[]") // JSON: [{actorId, actorType, dex, roll}]
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rounds      CombatRound[]

  @@index([roomId])
}

model CombatRound {
  id          String   @id @default(uuid())
  combatId    String
  roundNum    Int
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  combat      CombatSession @relation(fields: [combatId], references: [id], onDelete: Cascade)
  actions     CombatAction[]

  @@index([combatId])
}

model CombatAction {
  id          String   @id @default(uuid())
  roundId     String
  actorId     String
  actorType   String   @default("player") // player | npc | enemy
  actionType  String   // attack | dodge | spell | item | move | end
  targetId    String?
  targetType  String?
  description String?
  result      String   @default("{}") // JSON: {hit, damage, crit, effects}
  createdAt   DateTime @default(now())

  round       CombatRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

model RoomEventLog {
  id          String   @id @default(uuid())
  roomId      String
  phaseId     String?
  sceneId     String?
  userId      String?
  eventType   String   // DICE_ROLL | CLUE_DISCOVERED | PHASE_CHANGE | SCENE_CHANGE | COMBAT_ACTION | NPC_STATE_CHANGE | MEMBER_JOIN | MEMBER_LEAVE | STATUS_CHANGE
  payload     String   @default("{}") // JSON
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, eventType])
}

model GmNote {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  title       String
  content     String
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model ScenePreset {
  id          String   @id @default(uuid())
  roomId      String
  name        String
  atmosphere  String   @default("normal")
  sceneDesc   String?
  sceneImageUrl String?
  sceneMusicUrl String?
  npcSnapshots    String   @default("[]") // JSON
  clueSnapshots   String   @default("[]") // JSON
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model MemberSnapshot {
  id          String   @id @default(uuid())
  roomMemberId String
  snapshotData String   // JSON: {hp, mp, san, statusTags, items, skills}
  reason      String   @default("member_left") // member_left | combat_end | scene_change
  createdAt   DateTime @default(now())

  @@index([roomMemberId])
}

// ===== 跑团 Log（模块 9）=====

model RoomLog {
  id          String   @id @default(uuid())
  roomId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  events      RoomLogEvent[]
  annotations RoomLogAnnotation[]
  exports     RoomLogExport[]

  @@index([roomId])
}

model RoomLogEvent {
  id            String   @id @default(uuid())
  logId         String
  roomId        String
  eventType     String   // CHAT_TEXT | DICE_ROLL | SCENE_CHANGE | COMBAT_ACTION | CLUE_REVEAL | NPC_DIALOGUE | PHASE_CHANGE | SYSTEM_EVENT
  payload       String   // JSON
  timestamp     DateTime @default(now())
  characterId   String?
  characterName String?
  userId        String
  userNickname  String
  sortOrder     Int      @default(0)

  log           RoomLog  @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId, timestamp])
  @@index([roomId, eventType])
}

model RoomLogAnnotation {
  id          String   @id @default(uuid())
  logId       String
  fromEventId String
  toEventId   String?
  type        String   // NARRATION | MERGE | REDACT | NOTE
  content     String
  authorId    String   // KP userId
  createdAt   DateTime @default(now())

  log         RoomLog  @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}

model RoomLogExport {
  id          String   @id @default(uuid())
  logId       String
  format      String   // markdown | html | plain | json | pdf
  content     String
  fileUrl     String?
  options     String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  log         RoomLog  @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}

// ===== 子房间（模块 10）=====

model SubRoom {
  id            String   @id @default(uuid())
  parentRoomId  String
  name          String
  description   String?
  atmosphere    String   @default("normal")
  sceneImageUrl String?
  creatorId     String
  timeMode      String   @default("sync") // sync | paused | independent
  status        String   @default("active") // active | paused | dissolved
  sceneDesc     String?
  syncEvents    String   @default("[]") // JSON
  createdAt     DateTime @default(now())
  dissolvedAt   DateTime?

  parentRoom    Room     @relation(fields: [parentRoomId], references: [id], onDelete: Cascade)
  members       SubRoomMember[]
  messages      SubRoomMessage[]
  clues         SubRoomClue[]
  npcs          SubRoomNpc[]

  @@index([parentRoomId])
  @@index([status])
}

model SubRoomMember {
  id                String   @id @default(uuid())
  subRoomId         String
  userId            String
  roomMemberId      String
  characterId       String?
  characterSnapshot String?  // JSON
  role              String   @default("PLAYER")
  canInvite         Boolean  @default(false)
  joinedAt          DateTime @default(now())
  leftAt            DateTime?

  subRoom           SubRoom  @relation(fields: [subRoomId], references: [id], onDelete: Cascade)

  @@unique([subRoomId, userId])
  @@index([subRoomId])
}

model SubRoomMessage {
  id            String   @id @default(uuid())
  subRoomId     String
  userId        String
  nickname      String
  characterName String?
  content       String
  type          String   @default("text")
  rollData      String?
  timestamp     DateTime @default(now())

  subRoom       SubRoom  @relation(fields: [subRoomId], references: [id], onDelete: Cascade)

  @@index([subRoomId, timestamp])
}

model SubRoomClue {
  id           String   @id @default(uuid())
  subRoomId    String
  parentClueId String?
  content      String
  source       String
  category     String?
  isRevealed   Boolean  @default(false)
  discoveredBy String?
  createdAt    DateTime @default(now())

  subRoom      SubRoom  @relation(fields: [subRoomId], references: [id], onDelete: Cascade)

  @@index([subRoomId])
}

model SubRoomNpc {
  id          String   @id @default(uuid())
  subRoomId   String
  parentNpcId String?
  name        String
  description String?
  avatarUrl   String?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  subRoom     SubRoom  @relation(fields: [subRoomId], references: [id], onDelete: Cascade)

  @@index([subRoomId])
}

// ===== 现有模型 V2.1 扩展 =====

model RoomClue {
  id            String   @id @default(uuid())
  roomId        String
  title         String
  content       String
  imageUrl      String?
  discoveredBy  String   @default("all")
  isHidden      Boolean  @default(false)
  requiresSkill String?
  requiresValue Int?
  createdAt     DateTime @default(now())

  // ===== V2.1 新增 =====
  discoverySkill   String?
  discoveryThreshold Int?
  discoveredByUserId String?
  discoveredAt     DateTime?
  autoReveal       Boolean  @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RoomNpc {
  id          String   @id @default(uuid())
  roomId      String
  name        String
  avatarUrl   String?
  description String?
  statsJson   String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // ===== V2.1 新增 =====
  sceneId          String?
  isActiveInScene  Boolean  @default(true)
  dynamicStats     String   @default("{}")

  room  Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene RoomScene? @relation(fields: [sceneId], references: [id])

  @@index([roomId])
}

// 新增：平台级用户私信表
model UserMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentUserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedUserMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead, createdAt])
  @@index([senderId, receiverId, createdAt])
}

// 新增：倒计时表
model Countdown {
  id          String   @id @default(uuid())
  roomId      String
  title       String   // 倒计时标题
  duration    Int      // 秒数
  remaining   Int      // 剩余秒数
  isActive    Boolean  @default(true)
  createdBy   String   // 创建者userId
  createdAt   DateTime @default(now())
  endedAt     DateTime?

  room        Room     @relation(fields: [roomId], references: [id])

  @@index([roomId])
}

// ========== 位阶与印记系统 ==========

// 位阶配置表（管理员可配置）
model RankConfig {
  id          String   @id @default(uuid())
  level       Int      @unique
  name        String
  expRequired Int
  description String
  privileges  String   @default("[]")
  icon        String
  color       String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
  @@index([isActive])
}

// 印记配置表（管理员可配置）
model TitleConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  category    String
  rarity      String
  condition   String
  conditionCode String?
  expReward   Int
  icon        String
  color       String
  hint        String?
  isActive    Boolean  @default(true)
  isHidden    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([rarity])
  @@index([isActive])

  unlockedByUsers UserTitle[]
}

// 用户已解锁的印记
model UserTitle {
  id          String   @id @default(uuid())
  userId      String
  titleKey    String
  unlockedAt  DateTime @default(now())
  unlockedBy  String   @default("system")
  grantedBy   String?
  note        String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleConfig TitleConfig  @relation(fields: [titleKey], references: [key], onDelete: Cascade)

  @@unique([userId, titleKey])
  @@index([userId])
  @@index([titleKey])
}

// 用户位阶变更历史
model UserRankHistory {
  id          String   @id @default(uuid())
  userId      String
  oldLevel    Int
  newLevel    Int
  oldExp      Int
  newExp      Int
  reason      String
  changedBy   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 印记解锁日志
model TitleUnlockLog {
  id          String   @id @default(uuid())
  userId      String
  titleKey    String
  expReward   Int
  unlockedBy  String
  grantedBy   String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 公告/资讯表
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isPinned])
  @@index([publishedAt])
}

// 附件上传记录表
model Upload {
  id          String   @id @default(uuid())
  userId      String
  originalName String
  filename    String   @unique
  mimeType    String
  size        Int
  url         String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// 商店商品表
model ShopItem {
  id          String   @id @default(uuid())
  key         String   @unique  // 唯一标识，如 "rusted_chain"
  name        String
  description String
  category    String   // avatar_frame, dice_skin, card_skin, room_theme
  price       Int      @default(0)
  currency    String   @default("coin") // coin | stardust
  rarity      String   @default("common") // common | rare | epic | legendary | mythical
  iconUrl     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category, isActive])
  @@index([sortOrder])
}

// 用户背包表
model UserInventory {
  id          String   @id @default(uuid())
  userId      String
  itemKey     String
  quantity    Int      @default(1)
  purchasedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

// ========== 论坛系统（v1.4.0） ==========

model ForumBoard {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  posts       ForumPost[]
  moderators  ForumBoardModerator[]

  @@index([isActive])
  @@index([sortOrder])
}

model ForumBoardModerator {
  id        String   @id @default(uuid())
  boardKey  String
  userId    String
  createdAt DateTime @default(now())

  board     ForumBoard @relation(fields: [boardKey], references: [key], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardKey, userId])
  @@index([boardKey])
  @@index([userId])
}

model ForumPost {
  id          String   @id @default(uuid())
  boardKey    String
  userId      String
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isEssence   Boolean  @default(false)
  isLocked    Boolean  @default(false)
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  replyCount  Int      @default(0)
  bountyCoin  Int      @default(0) // 悬赏金额（锈蚀硬币）
  bestReplyId String?  // 最佳回复ID
  lastReplyAt DateTime @default(now())
  lastReplyById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board       ForumBoard      @relation(fields: [boardKey], references: [key], onDelete: Cascade)
  author      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReplyBy User?           @relation("LastReplyAuthor", fields: [lastReplyById], references: [id])
  replies     ForumReply[]
  likedBy     ForumPostLike[]

  @@index([boardKey, isPinned, lastReplyAt])
  @@index([boardKey, isEssence, lastReplyAt])
  @@index([userId])
  @@index([createdAt])
}

model ForumReply {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  content     String
  isBestReply Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model ForumPostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ForumRewardLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // create_post | create_reply | receive_like | best_reply
  postId    String?
  rewardExp Int      @default(0)
  rewardCoin Int     @default(0)
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // mention | reply | like | best_reply | system | rank_up | title_unlock | shop_purchase | forum_reply | forum_mention | moderator_action | system_announcement
  title     String
  content   String?
  link      String?
  postId    String?
  replyId   String?
  isRead    Boolean  @default(false)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("FriendshipsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id        String   @id @default(uuid())
  senderId  String
  receiverId String
  message   String?
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender   User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
}

// ========== 剧本跑团系统（Scenario） ==========

model AiNarrativeCache {
  id         String   @id @default(cuid())
  sessionId  String
  nodeId     String
  cacheKey   String
  promptHash String
  cachedText String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, nodeId, cacheKey])
  @@index([promptHash])
}


model ArgumentRecord {
  id              String   @id @default(cuid())
  sessionId       String
  doubtId         String
  selectedClueIds String   // JSON array string
  result          String   // SUCCESS | FAIL | ABORT
  createdAt       DateTime @default(now())

  session ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([doubtId])
}


model CharacterRelic {
  id            String   @id @default(uuid())
  characterId   String
  userId        String // 冗余索引，方便按用户查询
  relicKey      String // 对应 ShopItem.key
  source        String   @default("shop") // shop | room_drop | trade | gift
  durability    Int? // 当前耐久
  maxDurability Int? // 最大耐久
  usedCount     Int      @default(0) // 已使用次数（consumable）
  isEquipped    Boolean  @default(false) // 是否标记为常备（展示用）
  tradeLockId   String? // 若正在挂单，记录 RelicTrade.id
  acquiredAt    DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([userId])
  @@index([tradeLockId])
}


model Clue {
  id              String   @id @default(cuid())
  scenarioId      String
  name            String
  description     String
  icon            String?
  type            String   // PERSON | ITEM | EVENT | LOCATION
  unlockCondition String?  // JSON string
  createdAt       DateTime @default(now())

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([type])
}


model Doubt {
  id                String   @id @default(cuid())
  scenarioId        String
  nodeId            String
  title             String
  description       String
  requiredClueCount Int      @default(3)
  correctClueIds    String   // JSON array string
  successNodeId     String
  failNodeId        String
  maxRetry          Int      @default(3)
  modePunishment    String?  // JSON string
  createdAt         DateTime @default(now())

  scenario Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  node     ScenarioNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([nodeId])
}


model DreamCard {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  rarity    String   @default("common") // common | rare | epic | legendary
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model FishingConfig {
  id         String   @id @default(uuid())
  dailyLimit Int      @default(5)
  extraCost  Int      @default(10)
  updatedAt  DateTime @updatedAt
}


model FishingItem {
  id                 String   @id @default(uuid())
  key                String   @unique
  name               String
  description        String
  rarity             String // JUNK | COMMON | UNCOMMON | RARE | ELDRITCH
  sellPrice          Int      @default(0)
  sellCurrency       String   @default("coin") // coin | stardust
  isCollection       Boolean  @default(false)
  collectionCategory String?
  iconUrl            String?
  weight             Int      @default(100)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
}


model RelicOverride {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String?
  description String?
  type        String?
  iconUrl     String?
  updatedAt   DateTime @updatedAt
}


model RelicTrade {
  id                     String    @id @default(uuid())
  sellerId               String
  sellerCharacterRelicId String? // 若从角色上解绑交易，记录来源
  relicKey               String
  price                  Int
  currency               String    @default("coin")
  status                 String    @default("active") // active | sold | cancelled
  buyerId                String?
  relicSnapshot          String? // JSON: { durability, usedCount, maxDurability, isEquipped }
  createdAt              DateTime  @default(now())
  soldAt                 DateTime?

  @@index([status, createdAt])
  @@index([relicKey])
}



model Scenario {
  id          String   @id @default(cuid())
  title       String
  description String?  
  coverImage  String?

  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  difficulty  String    @default("NORMAL")
  estimatedDuration Int @default(120)
  maxPlayers  Int       @default(6)
  minPlayers  Int       @default(1)

  supportsKPLess Boolean @default(true)
  supportsKPMode Boolean @default(true)

  status      String    @default("DRAFT")
  version     Int       @default(1)

  tags        String?  
  era         String?
  location    String?

  playCount   Int       @default(0)
  rating      Float     @default(0)
  ratingCount Int       @default(0)

  startNodeId String?   @unique
  startNode   ScenarioNode? @relation("ScenarioStart", fields: [startNodeId], references: [id])

  nodes       ScenarioNode[]
  edges       ScenarioEdge[]
  sessions    ScenarioSession[]

  // 2.0 新增
  galleryImages String?
  assets        ScenarioAsset[]
  items         ScenarioItem[]
  achievements  UserAchievement[]

  // 3.0 新增
  characters    ScenarioCharacter[]
  doubts        Doubt[]
  clues         Clue[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([difficulty])
}


model ScenarioAsset {
  id          String   @id @default(cuid())
  scenarioId  String
  nodeId      String?
  npcName     String?
  itemName    String?
  type        String   // scene | npc_portrait | item_icon | ending_image
  imageUrl    String
  prompt      String?
  worldState  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, type])
  @@index([scenarioId, nodeId, worldState])
}


model ScenarioCharacter {
  id          String   @id @default(cuid())
  scenarioId  String
  name        String
  description String?
  avatar      String?  // 小头像/关系图头像
  sprites     String   // JSON string: { "calm": "url", "surprised": "url", ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
}


model ScenarioDiceResult {
  id          String   @id @default(cuid())
  sessionId   String
  session     ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId      String
  nodeId      String
  skill       String
  difficulty  Int
  rolledValue Int
  isSuccess   Boolean
  successLevel String?
  createdAt   DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
}


model ScenarioEdge {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  fromNodeId  String
  fromNode    ScenarioNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String
  toNode      ScenarioNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  type        String    @default("DEFAULT")
  conditions  String?  
  priority    Int       @default(0)
  label       String?
  isDefault   Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scenarioId])
  @@index([fromNodeId])
  @@index([toNodeId])
}


model ScenarioItem {
  id          String   @id @default(cuid())
  scenarioId  String
  key         String
  name        String
  description String?
  type        String   // consumable | key | clue
  iconUrl     String?
  effects     String   @default("[]")
  usableAt    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, key])
  @@index([scenarioId])
}


model ScenarioNode {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  nodeId      String
  worldState  String    @default("normal")
  title       String
  type        String
  content     String   

  positionX   Float     @default(0)
  positionY   Float     @default(0)
  metadata    String?  

  // 2.0 新增
  generatedImageUrl String?

  // 3.0 新增：AVG 演出字段
  bgUrl             String? // 场景背景图
  cgUrl             String? // CG 图
  bgmUrl            String? // 节点默认 BGM
  sfxUrl            String? // 节点入场音效
  transitionType    String  @default("fade") // fade | dissolve | wipe | glitch | ripple
  speakerId         String? // 当前说话角色的 ScenarioCharacter.id
  speakerExpression String? // 如 "fear"
  speakerPosition   String  @default("center") // left | center | right | custom
  speakerPositionX  Float?  // 当 position 为 custom 时生效（百分比 0-1）

  outgoingEdges ScenarioEdge[]  @relation("EdgeFrom")
  incomingEdges ScenarioEdge[]  @relation("EdgeTo")
  sessionsAsCurrent ScenarioSession[] @relation("CurrentNode")
  sessionStates   ScenarioSessionState[]
  scenariosAsStart Scenario? @relation("ScenarioStart")
  doubts          Doubt[] // 3.0 新增：关联的疑点

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([scenarioId, nodeId, worldState])
  @@index([scenarioId])
  @@index([type])
  @@index([scenarioId, worldState])
}


model ScenarioPlayerChoice {
  id          String   @id @default(cuid())
  sessionId   String
  session     ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId      String
  nodeId      String
  edgeId      String?
  choiceLabel String?
  createdAt   DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
}


model ScenarioSession {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  roomId      String?   @unique
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  mode        String
  status      String    @default("ACTIVE")
  currentNodeId String?
  currentNode   ScenarioNode? @relation("CurrentNode", fields: [currentNodeId], references: [id])

  globalState String?  
  visitedNodes String? 

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  duration    Int       @default(0)
  outcome     String?
  endingNodeId String?

  nodeStates  ScenarioSessionState[]
  playerChoices ScenarioPlayerChoice[]
  diceResults ScenarioDiceResult[]
  playerStates ScenarioSessionPlayerState[]

  // 3.0 新增：论证记录
  argumentRecords ArgumentRecord[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scenarioId])
  @@index([roomId])
  @@index([status])
}


model ScenarioSessionPlayerState {
  id          String   @id @default(cuid())
  sessionId   String
  session     ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId      String
  characterId String?

  // 该玩家在此剧本中的运行时状态（如临时 SAN 变更、剧本私有变量等）
  runtimeState String?

  // 2.0 新增：剧本内物品栏
  inventory String? @default("[]")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}


model ScenarioSessionState {
  id          String   @id @default(cuid())
  sessionId   String
  session     ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nodeId      String
  node        ScenarioNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  status      String    @default("PENDING")
  visitedAt   DateTime?
  completedAt DateTime?
  stateData   String?  
  result      String?  

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sessionId, nodeId])
  @@index([sessionId])
}


model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  scenarioId     String
  achievementKey String
  unlockedAt     DateTime @default(now())
  metadata       String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId, achievementKey])
  @@index([userId])
  @@index([scenarioId])
}


model UserDreamDaily {
  id         String   @id @default(uuid())
  userId     String   @unique
  date       String // YYYY-MM-DD
  drawCount  Int      @default(0)
  lastDrawAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}


model UserDreamDraw {
  id       String   @id @default(uuid())
  userId   String
  cardKey  String
  position String // upright | reversed
  drawnAt  DateTime @default(now())

  isRevealed Boolean   @default(false)
  revealedAt DateTime?
  revealText String?

  isDeepRevealed Boolean   @default(false)
  deepRevealedAt DateTime?
  deepRevealText String?
  tentacleBuff   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, drawnAt])
  @@index([userId])
}


model UserFishingDaily {
  id            String   @id @default(uuid())
  userId        String   @unique
  freeUsed      Int      @default(0)
  extraUsed     Int      @default(0)
  lastRefreshAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model UserFishingLog {
  id           String   @id @default(uuid())
  userId       String
  itemKey      String
  itemName     String
  rarity       String
  sellPrice    Int
  sellCurrency String
  isSold       Boolean  @default(false)
  caughtAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, caughtAt])
  @@index([userId])
}


