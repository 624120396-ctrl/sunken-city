# 环境变量配置
NODE_ENV=development
PORT=3001

# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/coc_platform?schema=public"

# Redis（可选）
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 前端URL（CORS）
CLIENT_URL="http://localhost:3000"