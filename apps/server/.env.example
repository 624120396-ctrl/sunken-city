# 环境变量配置
NODE_ENV=development
PORT=3001

# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/coc_platform?schema=public"

# Redis（可选）
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 前端URL（CORS）
CLIENT_URL="http://localhost:3000"

# 房间真人语音 V1（LiveKit）
LIVEKIT_URL="wss://voice.example.com"
LIVEKIT_API_KEY="livekit-api-key"
LIVEKIT_API_SECRET="livekit-api-secret"
LIVEKIT_TOKEN_TTL_SECONDS="900"
ROOM_VOICE_MAX_PARTICIPANTS="10"
ROOM_VOICE_OBSERVER_CAN_SPEAK="false"

# 私有舞台素材投递（只写入生产 server.env；不要提交真实 secret）
STAGE_ASSET_ROOT="/opt/coc-platform-data/stage-assets"
STAGE_ASSET_DELIVERY_BASE_URL="https://stage-assets.example.com/delivery"
STAGE_ASSET_DELIVERY_SECRET="replace-with-a-server-generated-secret"
